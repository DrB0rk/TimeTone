# Create web/.env with ../install.sh, or copy this file and set all values.
ADMIN_PASSWORD=change-this-password
ADMIN_SECRET=replace-with-at-least-32-random-bytes
# Set true when the app is served through HTTPS. Keep false for plain LAN HTTP.
COOKIE_SECURE=false
# Office timezone used for dashboard and reports (IANA format).
TIMEKEEP_TIMEZONE=Europe/Amsterdam
# Host port used by Docker Compose.
TIMETONE_PORT=3000
